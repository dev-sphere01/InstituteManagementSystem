# ==============================================================================
# INSTITUTE MANAGEMENT SYSTEM (IMS) — DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in the required production values for your domain / EC2 server.
#    All URL variables below MUST be explicitly set for production builds.
# 3. DO NOT commit the .env file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT MAPPINGS
# (Bound strictly to 127.0.0.1 on the host for reverse-proxying via host Nginx)
# ------------------------------------------------------------------------------
IMS_FRONTEND_PORT=3000
IMS_BACKEND_PORT=4000
EMS_API_PORT=5001
EMS_NODEAPI_PORT=5002
EMS_UI_PORT=3001

# ------------------------------------------------------------------------------
# APPLICATION URLS & CORS (REQUIRED IN PRODUCTION)
# Must match your public domains / HTTPS endpoints configured on host Nginx.
# Example:
#   FRONTEND_URL=https://ims.example.com
#   EMS_UI_URL=https://ems.example.com
# ------------------------------------------------------------------------------
FRONTEND_URL=https://ims.example.com
EMS_UI_URL=https://ems.example.com

# ------------------------------------------------------------------------------
# FRONTEND BUILD ARGS (API URLS & VERSION) (REQUIRED AT BUILD TIME)
# Vite embeds these into static JavaScript files during 'docker build'.
# In production, these MUST be the public URLs accessible from client browsers!
# Example:
#   VITE_IMS_API_BASE_URL=https://ims.example.com/api/v1
#   VITE_EMS_API_BASE_URL=https://ems.example.com
# ------------------------------------------------------------------------------
VITE_APP_STAGE=production
VITE_IMS_API_BASE_URL=https://ims.example.com/api/v1
VITE_EMS_API_BASE_URL=https://ems.example.com
VITE_API_TIMEOUT=30000
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# IMS BACKEND (Node.js / Express + MongoDB)
# Note: Containers reach native host databases via 'host.docker.internal' (172.17.0.1)
# ------------------------------------------------------------------------------
IMS_DB_URI=mongodb://host.docker.internal:27017/UserAuthTemplate
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRE=5d
COOKIE_EXPIRE=5
ESCALATION_INTERVAL_MINUTES=5
OVERDUE_INTERVAL_HOURS=24

# ------------------------------------------------------------------------------
# EMS API (ASP.NET Core 8 + MySQL)
# IMPORTANT SECURITY REQUIREMENTS:
# 1. NEVER use the MySQL 'root' user for application connections!
# 2. Restrict the application user strictly to the Docker subnet (172.17.%.%):
#    CREATE USER 'ims_app'@'172.17.%.%' IDENTIFIED BY 'YOUR_STRONG_PASSWORD_HERE';
#    GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES ON IMS.* TO 'ims_app'@'172.17.%.%';
#    FLUSH PRIVILEGES;
# 3. Ensure native MySQL binds to the Docker bridge IP (172.17.0.1) in mysqld.cnf:
#    bind-address = 127.0.0.1,172.17.0.1
#    (Do NOT expose MySQL port 3306 publicly on the internet)
# ------------------------------------------------------------------------------
EMS_DB_CONNECTION=server=host.docker.internal;port=3306;database=IMS;user=ims_app;password=replace_with_your_strong_password;
EMS_JWT_KEY=replace_with_a_secure_random_jwt_secret_at_least_32_chars
EMS_JWT_EXPIRE_TIME=360

# ------------------------------------------------------------------------------
# SMTP / EMAIL NOTIFICATIONS (IMS Backend)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
